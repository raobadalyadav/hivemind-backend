# Copy to .env (`cp .env.example .env`). `make run-api` / `make run-worker` load it.
# Every variable is optional — the defaults in config/config.go match docker-compose.

APP_ENV=dev

# Servers
GRPC_PORT=50051
WEBHOOK_PORT=8080

# Infrastructure (docker compose up -d)
DATABASE_URL=postgres://hivemind:hivemind@localhost:5432/hivemind?sslmode=disable
REDIS_ADDR=localhost:6379
NATS_URL=nats://localhost:4222
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=hivemind
MINIO_SECRET_KEY=hivemind123
MINIO_BUCKET=hivemind-media
MINIO_USE_SSL=false

# Uploads (photos/videos go through the API into MinIO/S3 above)
# Where phones fetch media from. Leave unset in dev: `make run-api` uses this machine's LAN IP.
# MEDIA_PUBLIC_BASE_URL=http://192.168.1.40:8080
MEDIA_MAX_IMAGE_MB=10
MEDIA_MAX_VIDEO_MB=60

# Auth — change both in any shared/production environment
JWT_SECRET=dev-secret-change-in-production
JWT_TTL=1h
# PASS_SECRET=          # defaults to JWT_SECRET + ":pass"

# Sign-in providers (needed for real Google/Apple login; leave empty for dev-token sign-in)
GOOGLE_CLIENT_ID=
APPLE_BUNDLE_ID=

# Optional integrations
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=noreply@hivemind.app
FIREBASE_CREDENTIALS_PATH=
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_SANDBOX=true

# Safety Center / SOS
EMERGENCY_NUMBER=112

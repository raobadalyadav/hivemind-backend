# Copy to .env (`cp .env.example .env`). `make run-api` / `make run-worker` load it.
# Every variable is optional — the defaults in config/config.go match docker-compose.

# dev | staging | production. With production the API and worker REFUSE to start while any secret is at its
# development default (JWT_SECRET, PASS_SECRET, DB credentials/sslmode, MinIO secret), URLs aren't https,
# CASHFREE_SANDBOX is true, or an env value is unparsable. gRPC reflection is off in production.
APP_ENV=dev

# Servers
GRPC_PORT=50051
WEBHOOK_PORT=8080

# Infrastructure (docker compose up -d)
DATABASE_URL=postgres://hivemind:hivemind@localhost:5432/hivemind?sslmode=disable
REDIS_ADDR=localhost:6379
NATS_URL=nats://localhost:4222
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=hivemind
MINIO_SECRET_KEY=hivemind123
MINIO_BUCKET=hivemind-media
MINIO_USE_SSL=false

# Uploads (photos/videos go through the API into MinIO/S3 above)
# Where phones fetch media from. Leave unset in dev: `make run-api` uses this machine's LAN IP.
# MEDIA_PUBLIC_BASE_URL=http://192.168.1.40:8080
# Origin of shareable links (posts/plans). The app opens these as Android app links / deep links.
# PUBLIC_WEB_BASE_URL=https://hivemind.app
MEDIA_MAX_IMAGE_MB=10
MEDIA_MAX_VIDEO_MB=60

# Auth — change both in any shared/production environment
JWT_SECRET=dev-secret-change-in-production
JWT_TTL=1h
# PASS_SECRET=          # dev: defaults to JWT_SECRET + ":pass". Production: required, 32+ chars, not derived from JWT_SECRET.

# Sign-in providers (needed for real Google/Apple login; leave empty for dev-token sign-in)
GOOGLE_CLIENT_ID=
APPLE_BUNDLE_ID=

# Optional integrations
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=noreply@hivemind.app
FIREBASE_CREDENTIALS_PATH=
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_SANDBOX=true

# Safety Center / SOS
EMERGENCY_NUMBER=112

# Transport and abuse protection
# TLS_CERT_FILE=        # serve gRPC over TLS directly; leave empty when a load balancer terminates TLS
# TLS_KEY_FILE=
# per signed-in user (0 = off)
RATE_LIMIT_PER_MINUTE=600
# per client IP for sign-in / refresh / recovery (0 = off)
AUTH_RATE_LIMIT_PER_MINUTE=20
# true only behind a proxy that sets X-Forwarded-For
TRUST_PROXY_HEADERS=false
# Postgres pool size per process (API and worker each keep their own pool)
DB_MAX_CONNS=20

# Receipts are issued in this name; have an accountant confirm the GST rate on the platform fee.
SELLER_NAME=HiveMind
SELLER_GSTIN=
SELLER_ADDRESS=
PLATFORM_FEE_GST_PERCENT=18

# Deep links: served at /.well-known/assetlinks.json (comma-separated SHA-256 of the signing certificates) and
# /.well-known/apple-app-site-association. Legal pages: put terms.html, privacy.html, support.html in LEGAL_DIR.
ANDROID_PACKAGE=app.hivemind.hivemind
ANDROID_CERT_SHA256=
APPLE_TEAM_ID=
LEGAL_DIR=
# Launch switches (GET /v1/app-config): builds older than MIN_APP_VERSION must update; a MAINTENANCE_MESSAGE shows a blocking notice.
MIN_APP_VERSION=
MAINTENANCE_MESSAGE=

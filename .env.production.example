# Production template — copy to your secret manager / deployment environment, never commit real values.
# With APP_ENV=production the API and worker refuse to start if anything below is left at a development default.
APP_ENV=production

GRPC_PORT=50051
WEBHOOK_PORT=8080
DB_MAX_CONNS=20

# Managed Postgres (+PostGIS), TLS on, a dedicated low-privilege role
DATABASE_URL=postgres://hivemind_app:CHANGE_ME@db.internal:5432/hivemind?sslmode=require
REDIS_ADDR=redis.internal:6379
NATS_URL=nats://nats.internal:4222

# Object storage (S3-compatible)
MINIO_ENDPOINT=s3.example.com
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME_32_CHARS_MIN_RANDOM______
MINIO_BUCKET=hivemind-media
MINIO_USE_SSL=true

# Random values: openssl rand -base64 48   (JWT_SECRET and PASS_SECRET must differ)
JWT_SECRET=CHANGE_ME
JWT_TTL=1h
PASS_SECRET=CHANGE_ME_TOO

# Public URLs (https only)
PUBLIC_WEB_BASE_URL=https://hivemind.app
MEDIA_PUBLIC_BASE_URL=https://api.hivemind.app

# Sign-in providers
GOOGLE_CLIENT_ID=
APPLE_BUNDLE_ID=

# Notifications
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=noreply@hivemind.app
FIREBASE_CREDENTIALS_PATH=/run/secrets/firebase.json

# Payments — production keys, sandbox off
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_SANDBOX=false

EMERGENCY_NUMBER=112

# Transport and abuse protection (terminate TLS at the load balancer, or set the two TLS_* files)
# TLS_CERT_FILE=/run/secrets/tls.crt
# TLS_KEY_FILE=/run/secrets/tls.key
RATE_LIMIT_PER_MINUTE=600
AUTH_RATE_LIMIT_PER_MINUTE=20
# true only when a trusted proxy sets X-Forwarded-For
TRUST_PROXY_HEADERS=true

# Receipts (required in production)
SELLER_NAME=Your Company Pvt Ltd
SELLER_GSTIN=
SELLER_ADDRESS=
PLATFORM_FEE_GST_PERCENT=18

# Deep links + legal pages (serve on the PUBLIC_WEB_BASE_URL host)
ANDROID_PACKAGE=app.hivemind.hivemind
ANDROID_CERT_SHA256=
APPLE_TEAM_ID=
LEGAL_DIR=/app/legal
# Launch switches (GET /v1/app-config): builds older than MIN_APP_VERSION must update; a MAINTENANCE_MESSAGE shows a blocking notice.
MIN_APP_VERSION=
MAINTENANCE_MESSAGE=
